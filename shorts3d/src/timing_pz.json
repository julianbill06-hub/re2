{
"line": 0,
"start": 0.0,
"end": 2.109,
"de": "steig niemals an Gleis Null aus."
},
{
"line": 1,
"start": 2.545,
"end": 4.364,
"de": "Du schläfst im letzten Nachzug ein."
},
{
"line": 1,
"start": 4.836,
"end": 6.764,
"de": "Als du aufwachst, ist der Wagen leer."
},
{
"line": 2,
"start": 7.327,
"end": 8.055,
"de": "Der Zug steht."
},
{
"line": 2,
"start": 8.673,
"end": 9.582,
"de": "Draußen ein Schild."
},
{
"line": 2,
"start": 10.091,
"end": 10.818,
"de": "Gleis Null."
},
{
"line": 3,
"start": 11.182,
"end": 11.655,
"de": "Endstation."
},
{
"line": 3,
"start": 12.255,
"end": 13.564,
"de": "Bitte alle aussteigen."
},
{
"line": 4,
"start": 14.164,
"end": 15.545,
"de": "Hinter dir steht der Schaffner."
},
{
"line": 4,
"start": 16.018,
"end": 16.545,

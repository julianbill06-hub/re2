},
{
"line": 5,
"start": 18.891,
"end": 19.855,
"de": "Er zeigt auf die Tür."
},
{
"line": 5,
"start": 20.455,
"end": 22.6,
"de": "Bleibst du sitzen oder steigst du aus?"
},
{
"line": 6,
"start": 23.218,
"end": 23.964,
"de": "Du bleibst sitzen."
},
{
"line": 6,
"start": 24.655,
"end": 25.782,
"de": "Die Türen schließen sich."
},
{
"line": 7,
"start": 26.327,
"end": 28.145,
"de": "Hinter den Fenstern nur schwarz."
},
{
"line": 7,
"start": 28.673,
"end": 29.709,
"de": "Die Durchsage zählt."
},
{
"line": 7,
"start": 30.291,
"end": 32.382,
"de": "Drei, zwei, eins."
},
{
"line": 8,
"start": 33.055,
"end": 33.473,
"de": "Licht aus."
},
{
"line": 8,
"start": 34.109,
"end": 36.364,
"de": "Der rote Punkt sitzt direkt neben dir."
},
{
"line": 9,
"start": 37.055,
"end": 37.727,
"de": "Zurückspulen."
},
{
"line": 9,
"start": 38.2,
"end": 39.836,
"de": "Denn Weg zwei ist schlimmer."
},
{
"line": 10,
"start": 40.327,
"end": 41.055,
"de": "Du steigst aus."
},
{
"line": 10,
"start": 41.618,
"end": 42.436,
"de": "Das Licht flackert."
},
{
"line": 10,
"start": 42.909,
"end": 43.8,
"de": "Er steht hinter dir."
},
{
"line": 11,
"start": 44.327,
"end": 45.055,
"de": "Es flackert wieder."
},
{
"line": 11,
"start": 45.636,
"end": 46.418,
"de": "Er ist näher."
},
{
"line": 12,
"start": 46.418,
"end": 47.927,
"de": "Du rennst die Treppe hoch."
},
{
"line": 12,
"start": 48.364,
"end": 49.0,
"de": "Morgenlicht."
},
{
"line": 12,
"start": 49.364,
"end": 49.727,
"de": "Menschen."
},
{
"line": 12,
"start": 50.273,
"end": 50.745,
"de": "Geschafft."
},
{
"line": 13,
"start": 51.273,
"end": 52.727,
"de": "Dann greifst du in deine Tasche."
},
{
"line": 14,
"start": 53.164,
"end": 53.8,
"de": "Ein Fahrschein."
},
{
"line": 14,
"start": 54.327,
